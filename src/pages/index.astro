---
import Base from "../layouts/Base.astro";
import Cover from "../components/Cover.astro";
import HomeJournal from "../components/HomeJournal.astro";
import { latest } from "../journal";
import { allPosts } from "../posts";
import { allProjects } from "../projects";
import { PROJECT_TOPICS, showcase } from "../work";
import HeroNetwork from "../components/HeroNetwork.astro";

const newest = latest(await allPosts());
const { lead, more } = showcase(await allProjects());
/* R-HOME-2. Each sentence rests on what the site already says: the hero,
 * the founders' profiles and the Rebel Match project. */
const FOCUS_AREAS = [
  {
    title: "Events and communities",
    text: "Tools for the moments people meet — like Rebel Match, which connects peers in a conference break.",
  },
  {
    title: "Organisations and foundations",
    text: "Help for non-profits and foundations: choosing their tools, agreeing who decides what, and getting the numbers they need from their own data.",
  },
  {
    title: "Free and open",
    text: "Pro bono, and open source wherever we can: anyone can read how Rebel Match works and build on it.",
  },
];
const topics = (project: {
  data: { topics: (keyof typeof PROJECT_TOPICS)[] };
}) => project.data.topics.map((topic) => PROJECT_TOPICS[topic]).join(" · ");
---

<Base
  title="xigo — software for the people who bring people together"
  description="xigo builds tools and shares practices for events, communities, non-profits and foundations — free of charge and in the open."
>
  <section class="hero">
    <div class="statement">
      <p class="label">
        <span class="dot">●</span> Pro bono · Events · Communities · Foundations
      </p>
      <h1>Software for the people who bring people together.</h1>
      <p class="lead muted">
        We build tools and share practices for events, communities, non-profits
        and foundations — free of charge and in the open. It’s our way of giving
        back.
      </p>
      <div class="actions">
        <a class="button primary" href="/work">
          See our work
        </a>
        <a class="button" href="/about">
          About xigo
        </a>
      </div>
    </div>
    <HeroNetwork />
  </section>

  <section class="focus" aria-labelledby="focus-heading">
    <h2 id="focus-heading" class="label">
      What we help with
    </h2>
    <ul class="areas">
      {FOCUS_AREAS.map((area) => (
        <li>
          <h3>{area.title}</h3>
          <p class="muted">{area.text}</p>
        </li>
      ))}
    </ul>
  </section>

  {lead && (
    <section class="work" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading">Our work</h2>
        <a class="all" href="/work">
          All projects →
        </a>
      </div>
      <a class="project-lead" href={`/work/${lead.id}`}>
        <Cover
          src={lead.data.image}
          alt={lead.data.imageAlt}
          sizes="(min-width: 900px) 60vw, 100vw"
        />
        <span class="text">
          <span class="label">
            {lead.data.featured && <span class="dot">Featured · </span>}
            {lead.data.year} · {topics(lead)}
          </span>
          <span class="title">{lead.data.title}</span>
          <span class="muted">{lead.data.summary}</span>
        </span>
      </a>
      {more.length > 0 && (
        <ul class="more">
          {more.map((project) => (
            <li>
              <a href={`/work/${project.id}`}>
                <Cover
                  src={project.data.image}
                  alt={project.data.imageAlt}
                  sizes="(min-width: 1000px) 560px, 100vw"
                />
                <span class="label">
                  {project.data.year} · {topics(project)}
                </span>
                <span class="title">{project.data.title}</span>
                <span class="muted">{project.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  <section class="journal bleed" aria-labelledby="journal-heading">
    <div class="section-head">
      <h2 id="journal-heading">Journal</h2>
      <a class="all" href="/journal">
        All posts →
      </a>
    </div>
    <HomeJournal posts={newest} />
  </section>

  <section id="contact" class="contact bleed">
    <p class="label">Contact</p>
    <h2>
      Running an event, a community or a foundation?{" "}
      <span class="muted">Let’s see how we can help — for free.</span>
    </h2>
    <a class="mail" href="mailto:info@xigo.ch">
      info@xigo.ch
    </a>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    padding: 96px 0 112px;
  }

  .statement {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding: 56px 0 72px;
    }

    .hero :global(.hero-network) {
      display: none;
    }
  }

  h1 {
    font-size: clamp(44px, 6.5vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .label,
  .lead {
    margin: 0;
  }

  .lead {
    max-width: 480px;
    font-size: 18px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 28px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px;
  }

  /* The focus areas share the hero's dark ground, so they are set apart by
   * air and by type: their titles are the page's second large moment. */
  .focus {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 0 0 clamp(96px, 12vw, 160px);
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px clamp(32px, 4vw, 64px);
  }

  .areas li {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }

  .areas h3 {
    font-size: clamp(32px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .areas p {
    margin: 0;
    max-width: 34ch;
    font-size: 17px;
    text-wrap: pretty;
  }

  @media (max-width: 860px) {
    .areas {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* No hairline between sections: the journal's and contact's own surfaces
   * separate them from what comes before (R-HOME-7). */
  .work,
  .journal {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .work {
    padding: 0 0 clamp(96px, 12vw, 160px);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .section-head h2 {
    font-size: clamp(36px, 4.5vw, 56px);
  }

  .all {
    font-size: 15px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
  }

  .project-lead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px clamp(40px, 5vw, 72px);
    align-items: center;
  }

  /* The one place the page breaks its grid: the image runs out to the
   * window, and keeps its rounded corners only on the side still inside. */
  .project-lead :global(.cover) {
    margin-left: calc(-1 * var(--bleed));
  }

  .project-lead :global(.cover img) {
    border-radius: 0 24px 24px 0;
  }

  @media (max-width: 900px) {
    .project-lead {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .text,
  .more a {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .text .label,
  .more .label {
    margin: 0;
  }

  .title {
    font-family: var(--font-display);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .project-lead .title {
    font-size: clamp(40px, 5vw, 72px);
  }

  .more {
    list-style: none;
    margin: 0;
    padding: 48px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 48px;
  }

  .more .title {
    font-size: clamp(28px, 3vw, 36px);
  }

  .project-lead:hover .title,
  .project-lead:focus-visible .title,
  .more a:hover .title,
  .more a:focus-visible .title {
    color: var(--accent);
  }

  .journal {
    background: var(--surface);
    padding-block: clamp(80px, 10vw, 128px);
  }

  /* Contact is inverted, so the site's light-on-dark colours, link hover and
   * gold focus ring would vanish here. Near-black on #edebe6 is 16:1, the
   * muted #5a5853 is 6:1 (R-WEB-2). */
  .contact {
    --ink: var(--ground);
    --ink-muted: #5a5853;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    padding-block: clamp(96px, 14vw, 176px);
    background: var(--text);
    color: var(--ink);
  }

  .contact .label {
    margin: 0;
    color: var(--ink-muted);
  }

  .contact h2 {
    width: 100%;
    max-width: 1040px;
    font-size: clamp(40px, 6vw, 84px);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .contact .muted {
    color: var(--ink-muted);
  }

  .mail {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 64px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 6px;
  }

  .contact .mail:hover,
  .contact .mail:focus-visible {
    color: var(--ink);
    border-bottom-color: #7a5c2a;
  }

  .contact :focus-visible {
    outline-color: var(--ink);
  }

  .button.primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--ground);
    font-weight: 500;
  }
</style>
