---
import Base from "../layouts/Base.astro";
import Cover from "../components/Cover.astro";
import HomeJournal from "../components/HomeJournal.astro";
import { latest } from "../journal";
import { allPosts } from "../posts";
import { allProjects } from "../projects";
import { PROJECT_TOPICS, showcase } from "../work";
import HeroNetwork from "../components/HeroNetwork.astro";

const newest = latest(await allPosts());
const { lead, more } = showcase(await allProjects());
const topics = (project: {
  data: { topics: (keyof typeof PROJECT_TOPICS)[] };
}) => project.data.topics.map((topic) => PROJECT_TOPICS[topic]).join(" · ");
---

<Base
  title="xigo — software for the people who bring people together"
  description="xigo builds tools and shares practices for events, communities, non-profits and foundations — free of charge and in the open."
>
  <section class="hero">
    <div class="statement">
      <p class="label">
        <span class="dot">●</span> Pro bono · Events · Communities · Foundations
      </p>
      <h1>Software for the people who bring people together.</h1>
      <p class="lead muted">
        We build tools and share practices for events, communities, non-profits
        and foundations — free of charge and in the open. It’s our way of giving
        back.
      </p>
      <div class="actions">
        <a class="button primary" href="/work">
          See our work
        </a>
        <a class="button" href="/about">
          About xigo
        </a>
      </div>
    </div>
    <HeroNetwork />
  </section>

  {lead && (
    <section class="work" aria-labelledby="work-heading">
      <div class="section-head">
        <h2 id="work-heading">Our work</h2>
        <a class="all" href="/work">
          All projects →
        </a>
      </div>
      <a class="project-lead" href={`/work/${lead.id}`}>
        <Cover
          src={lead.data.image}
          alt={lead.data.imageAlt}
          sizes="(min-width: 1000px) 640px, 100vw"
        />
        <span class="text">
          <span class="label">
            {lead.data.featured && <span class="dot">Featured · </span>}
            {lead.data.year} · {topics(lead)}
          </span>
          <span class="title">{lead.data.title}</span>
          <span class="muted">{lead.data.summary}</span>
        </span>
      </a>
      {more.length > 0 && (
        <ul class="more">
          {more.map((project) => (
            <li>
              <a href={`/work/${project.id}`}>
                <Cover
                  src={project.data.image}
                  alt={project.data.imageAlt}
                  sizes="(min-width: 1000px) 560px, 100vw"
                />
                <span class="label">
                  {project.data.year} · {topics(project)}
                </span>
                <span class="title">{project.data.title}</span>
                <span class="muted">{project.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  <section class="journal" aria-labelledby="journal-heading">
    <div class="section-head">
      <h2 id="journal-heading">Journal</h2>
      <a class="all" href="/journal">
        All posts →
      </a>
    </div>
    <HomeJournal posts={newest} />
  </section>

  <section id="contact" class="contact">
    <p class="label">Contact</p>
    <h2>
      Running an event, a community or a foundation?{" "}
      <span class="muted">Let’s see how we can help — for free.</span>
    </h2>
    <div class="reach">
      <a class="button primary" href="/contact">
        Write to us
      </a>
      <a class="mail" href="mailto:info@xigo.ch">
        info@xigo.ch
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    padding: 96px 0 128px;
  }

  .statement {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero :global(.hero-network) {
      display: none;
    }
  }

  h1 {
    font-size: clamp(44px, 6.5vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .label,
  .lead {
    margin: 0;
  }

  .lead {
    max-width: 480px;
    font-size: 18px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 28px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px;
  }

  .work,
  .journal {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 96px 0;
    border-top: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .section-head h2 {
    font-size: clamp(36px, 4.5vw, 56px);
  }

  .all {
    font-size: 15px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 4px;
  }

  .project-lead {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 32px 48px;
    align-items: center;
  }

  .text,
  .more a {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .text .label,
  .more .label {
    margin: 0;
  }

  .title {
    font-family: var(--font-display);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .project-lead .title {
    font-size: clamp(36px, 5vw, 64px);
  }

  .more {
    list-style: none;
    margin: 0;
    padding: 48px 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 48px;
  }

  .more .title {
    font-size: clamp(28px, 3vw, 36px);
  }

  .project-lead:hover .title,
  .project-lead:focus-visible .title,
  .more a:hover .title,
  .more a:focus-visible .title {
    color: var(--accent);
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    padding: 128px 0;
    border-top: 1px solid var(--line);
  }

  .contact .label {
    margin: 0;
  }

  .contact h2 {
    max-width: 900px;
    font-size: clamp(40px, 6vw, 80px);
    letter-spacing: -0.04em;
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
  }

  .mail {
    font-family: var(--font-display);
    font-size: 24px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 6px;
  }

  .button.primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--ground);
    font-weight: 500;
  }
</style>
