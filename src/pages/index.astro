---
import Base from "../layouts/Base.astro";
---

<Base
  title="xigo — software for the people who bring people together"
  description="xigo builds tools and shares practices for events, communities, non-profits and foundations — free of charge and in the open."
>
  <section class="hero">
    <p class="label">
      <span class="dot">●</span> Pro bono · Events · Communities · Foundations
    </p>
    <h1>Software for the people who bring people together.</h1>
    <p class="lead muted">
      We build tools and share practices for events, communities, non-profits
      and foundations — free of charge and in the open. It’s our way of giving
      back.
    </p>
    <div class="actions">
      <a class="button primary" href="/work">
        See our work
      </a>
      <a class="button" href="/about">
        About xigo
      </a>
    </div>
  </section>

  <section id="contact" class="contact">
    <p class="label">Contact</p>
    <h2>
      Running an event, a community or a foundation?
      <span class="muted">Let’s see how we can help — for free.</span>
    </h2>
    <a class="mail" href="mailto:info@xigo.ch">
      info@xigo.ch
    </a>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 96px 0 128px;
    max-width: 820px;
  }

  h1 {
    font-size: clamp(48px, 7vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .label,
  .lead {
    margin: 0;
  }

  .lead {
    max-width: 480px;
    font-size: 18px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 28px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px;
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    padding: 128px 0;
    border-top: 1px solid var(--line);
  }

  .contact .label {
    margin: 0;
  }

  .contact h2 {
    max-width: 900px;
    font-size: clamp(40px, 6vw, 80px);
    letter-spacing: -0.04em;
  }

  .mail {
    font-family: var(--font-display);
    font-size: 24px;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 6px;
  }

  .button.primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--ground);
    font-weight: 500;
  }
</style>
