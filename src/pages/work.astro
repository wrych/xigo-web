---
import Base from "../layouts/Base.astro";
import Cover from "../components/Cover.astro";
import PageIntro from "../components/PageIntro.astro";
import { allProjects } from "../projects";
import { PROJECT_TOPICS } from "../work";

const title = "Work";
const intro =
  "What we have built for events, communities and organisations — pro bono, and open source wherever we can.";
const projects = await allProjects();
---

<Base title={title} description={intro}>
  <PageIntro title={title} intro={intro} />

  <ul class="projects">
    {projects.map((project) => (
      <li class:list={{ featured: project.data.featured }}>
        <a href={`/work/${project.id}`}>
          <Cover
            src={project.data.image}
            alt={project.data.imageAlt}
            sizes="100vw"
          />
          <span class="text">
            <span class="head">
              <span class="label">
                {project.data.featured && <span class="dot">Featured · </span>}
                {project.data.year} ·{" "}
                {project.data.topics
                  .map((topic) => PROJECT_TOPICS[topic])
                  .join(" · ")}
              </span>
              <span class="title">{project.data.title}</span>
            </span>
            <span class="summary muted">{project.data.summary}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0 0 clamp(80px, 10vw, 128px);
    display: flex;
    flex-direction: column;
    gap: clamp(80px, 10vw, 128px);
  }

  li a {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* The featured image runs out to the window, and keeps its rounded
   * corners only on the side still inside the column (R-WORK-7). */
  .featured :global(.cover) {
    margin-right: calc(-1 * var(--bleed));
  }

  .featured :global(.cover img) {
    border-radius: 24px 0 0 24px;
  }

  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 24px 48px;
    align-items: end;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .summary {
    max-width: 460px;
    font-size: 18px;
    text-wrap: pretty;
  }

  li a:hover .title,
  li a:focus-visible .title {
    color: var(--accent);
  }
</style>
