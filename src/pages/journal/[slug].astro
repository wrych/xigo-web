---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import { TOPICS, formatDate, readingMinutes } from "../../journal";
import { allPosts, type Post } from "../../posts";

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, date, author, topic, excerpt, cover, coverAlt, original } =
  post.data;
const minutes = readingMinutes(post.body ?? "");
---

<Base title={title} description={excerpt}>
  <article>
    <header>
      <p class="label">
        <a href={`/journal/topic/${topic}`}>{TOPICS[topic]}</a>
      </p>
      <h1>{title}</h1>
      <p class="meta muted">
        {author} ·{" "}
        <time datetime={date.toISOString().slice(0, 10)}>
          {formatDate(date)}
        </time>{" "}
        · {minutes} min read
      </p>
      {original && (
        <p class="meta muted">
          First published on <a href={original.url}>{original.site}</a>,{" "}
          {formatDate(original.date)}.
        </p>
      )}
    </header>
    {cover && coverAlt && (
      <Cover
        src={cover}
        alt={coverAlt}
        sizes="(min-width: 800px) 760px, 100vw"
      />
    )}
    <div class="body">
      <Content />
    </div>
    <p class="back">
      <a href="/journal">All posts</a>
    </p>
  </article>
</Base>

<style>
  article {
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 0 128px;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 48px;
  }

  header p {
    margin: 0;
  }

  h1 {
    font-size: clamp(36px, 5vw, 64px);
  }

  .meta {
    font-size: 14px;
  }

  .meta a,
  .label a,
  .body :global(a),
  .back a {
    border-bottom: 1px solid var(--accent);
  }

  header + :global(.cover) {
    margin-bottom: 48px;
  }

  .body {
    font-size: 18px;
    line-height: 1.7;
  }

  .body :global(h2) {
    font-size: 28px;
    margin: 48px 0 16px;
    letter-spacing: -0.02em;
  }

  .body :global(li) {
    margin-bottom: 8px;
  }

  .back {
    margin-top: 64px;
  }
</style>
