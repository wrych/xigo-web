---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { COVER_WIDTHS } from "../journal";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
}

const { src, alt, sizes } = Astro.props;
---

<div class="cover">
  <Picture
    src={src}
    alt={alt}
    widths={COVER_WIDTHS}
    sizes={sizes}
    formats={["webp"]}
    fallbackFormat="jpg"
  />
</div>

<style>
  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 24px;
  }
</style>
