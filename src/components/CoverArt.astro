---
/* A post's cover, generated from its slug and topic (R-JOUR-6, ADR 0010).
 * Inline SVG drawn at build time: no request, no JavaScript. Decorative, so
 * hidden from assistive technology — the post's title stands beside it. */
import type { Topic } from "../journal";
import { coverSvg, type CoverShape } from "../covers";

interface Props {
  slug: string;
  topic: Topic;
  shape?: CoverShape;
}

const { slug, topic, shape = "wide" } = Astro.props;
---

<span
  class:list={["cover-frame", shape]}
  set:html={coverSvg(slug, topic, shape)}
/>

<style>
  .cover-frame {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--surface);
    aspect-ratio: 16 / 9;
  }

  .cover-frame.card {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
  }

  .cover-frame :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(a:hover) > .cover-frame,
  :global(a:focus-visible) > .cover-frame {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cover-frame {
      transition: border-color 0.3s ease;
    }
  }
</style>
