---
import type { CollectionEntry } from "astro:content";
import CoverArt from "./CoverArt.astro";
import { TOPICS, formatDate, readingMinutes } from "../journal";

interface Props {
  posts: CollectionEntry<"journal">[];
}

const [lead, ...side] = Astro.props.posts;
const isoDate = (post: CollectionEntry<"journal">) =>
  post.data.date.toISOString().slice(0, 10);
const minutes = (post: CollectionEntry<"journal">) =>
  readingMinutes(post.body ?? "");
---

{lead && (
  <div class="journal-grid">
    <a class="lead" href={`/journal/${lead.id}`}>
      <CoverArt slug={lead.id} topic={lead.data.topic} />
      <span class="topic">{TOPICS[lead.data.topic]}</span>
      <span class="title">{lead.data.title}</span>
      <span class="muted">{lead.data.excerpt}</span>
      <span class="meta">
        {lead.data.author} ·{" "}
        <time datetime={isoDate(lead)}>{formatDate(lead.data.date)}</time> ·{" "}
        {minutes(lead)} min read
      </span>
    </a>
    {side.length > 0 && (
      <ul class="side">
        {side.map((post) => (
          <li>
            <a href={`/journal/${post.id}`}>
              <CoverArt slug={post.id} topic={post.data.topic} shape="card" />
              <span class="text">
                <span class="label">{TOPICS[post.data.topic]}</span>
                <span class="title">{post.data.title}</span>
                <span class="meta">
                  {post.data.author} ·{" "}
                  <time datetime={isoDate(post)}>
                    {formatDate(post.data.date)}
                  </time>{" "}
                  · {minutes(post)} min
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
)}

<style>
  .journal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 48px;
    align-items: start;
  }

  .lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .lead :global(.cover-frame) {
    margin-bottom: 4px;
  }

  .topic {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .title {
    font-family: var(--font-display);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .lead .title {
    font-size: clamp(30px, 3.6vw, 44px);
  }

  .meta {
    font-size: 13px;
    color: var(--muted);
  }

  .side {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .side li + li {
    border-top: 1px solid var(--line);
    margin-top: 32px;
    padding-top: 32px;
  }

  .side a {
    display: grid;
    grid-template-columns: clamp(96px, 35%, 200px) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .side .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .side .label {
    margin: 0;
  }

  .side .title {
    font-size: 21px;
  }

  .lead:hover .title,
  .lead:focus-visible .title,
  .side a:hover .title,
  .side a:focus-visible .title {
    color: var(--accent);
  }
</style>
