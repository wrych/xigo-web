---
import type { CollectionEntry } from "astro:content";
import CoverArt from "./CoverArt.astro";
import { TOPICS, formatDate } from "../journal";

interface Props {
  posts: CollectionEntry<"journal">[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={`/journal/${post.id}`}>
        <CoverArt slug={post.id} topic={post.data.topic} shape="card" />
        <span class="text">
          <span class="meta">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatDate(post.data.date)}
            </time>{" "}
            · <span class="topic">{TOPICS[post.data.topic]}</span>
          </span>
          <span class="title">{post.data.title}</span>
          <span class="excerpt">{post.data.excerpt}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  li a {
    display: grid;
    grid-template-columns: clamp(96px, 20%, 184px) minmax(0, 1fr);
    gap: 16px clamp(20px, 4vw, 40px);
    align-items: center;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }

  .meta,
  .excerpt {
    color: var(--muted);
    font-size: 14px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .excerpt {
    font-size: 15px;
    line-height: 1.55;
  }

  a:hover .title,
  a:focus-visible .title {
    color: var(--accent);
  }
</style>
