---
import type { CollectionEntry } from "astro:content";
import { TOPICS, formatDate } from "../journal";

interface Props {
  posts: CollectionEntry<"journal">[];
  excerpts?: boolean;
}

const { posts, excerpts = true } = Astro.props;
---

<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={`/journal/${post.id}`}>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {formatDate(post.data.date)}
        </time>
        <span class="text">
          <span class="title">{post.data.title}</span>
          {excerpts && <span class="excerpt">{post.data.excerpt}</span>}
        </span>
        <span class="topic">{TOPICS[post.data.topic]}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  li a {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 8px 32px;
    align-items: baseline;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }

  time,
  .topic,
  .excerpt {
    color: var(--muted);
    font-size: 14px;
  }

  .text {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: -0.015em;
  }

  .excerpt {
    font-size: 15px;
    line-height: 1.55;
  }

  .topic {
    text-align: right;
  }
</style>
