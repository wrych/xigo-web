{
  "name": "xigo-web",
  "version": "0.1.0",
  "private": true,
  "description": "The website of xigo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.13.x"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"tests/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,mjs,ts,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
